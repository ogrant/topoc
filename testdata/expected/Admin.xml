<?xml version="1.0" encoding="UTF-8"?>
<!-- Admin :: generated by topoc; do not edit by hand -->
<AMPSConfig>
  <Name>Admin</Name>
  <Group>Admin</Group>
  <Admin>
    <InetAddr>${ADMIN_ADMIN_INETADDR}</InetAddr>
    <SQLTransport>websocket-any</SQLTransport>
  </Admin>
  <Logging>
    <Target>
      <Protocol>stdout</Protocol>
      <Level>info</Level>
    </Target>
  </Logging>
  <Transports>
    <Transport>
      <Name>client</Name>
      <Type>tcp</Type>
      <InetAddr>${ADMIN_CLIENT_INETADDR}</InetAddr>
      <Protocol>amps</Protocol>
    </Transport>
    <Transport>
      <Name>websocket-any</Name>
      <Type>tcp</Type>
      <InetAddr>${ADMIN_WEBSOCKET_INETADDR}</InetAddr>
      <Protocol>websocket</Protocol>
    </Transport>
  </Transports>
  <Actions>
    <Action>
      <On>
        <Module>amps-action-on-startup</Module>
      </On>
      <Do>
        <Module>amps-action-do-truncate-statistics</Module>
        <Options>
          <Age>5d</Age>
        </Options>
      </Do>
    </Action>
    <Action>
      <On>
        <Module>amps-action-on-shutdown</Module>
      </On>
      <Do>
        <Module>amps-action-do-remove-journal</Module>
        <Options>
          <Age>10s</Age>
        </Options>
      </Do>
    </Action>
  </Actions>
</AMPSConfig>
